[Unit]
Description=DICOM RT GPU Segmentation Portal
After=network-online.target

[Service]
Type=simple
User=rtsegmentator
WorkingDirectory=/opt/rtsegmentator
Environment=SEGMENTATION_WORKER=worker@rtsegmentator-worker
Environment=WORKER_MODE=ssh
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rtsegmentator/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
