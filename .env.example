# Put the portal behind an authenticated TLS proxy. No in-app API-key enforcement.
RETENTION_HOURS=24
MAX_UPLOAD_BYTES=8589934592

# local: WebUI and GPU inference in one container
# ssh: WebUI sends selected series to a remote GPU worker
WORKER_MODE=local
SEGMENTATION_WORKER=worker@rtsegmentator-worker
WORKER_SSH_PORT=2222
REMOTE_JOB_ROOT=/home/worker/jobs
REMOTE_PYTHON=/opt/rtsegmentator/venv/bin/python
REMOTE_RUNNER=/app/run_task.py
REMOTE_APP_ROOT=/app
REMOTE_MODEL_ROOT=/models
REMOTE_RUNTIME_ROOT=/runtimes
LOCAL_PYTHON=/opt/rtsegmentator/venv/bin/python
LOCAL_RUNNER=/app/run_task.py

# Local container mounts (see docs/CONTAINERS.md)
RTSEG_MODEL_BUNDLE=./models
RTSEG_RUNTIME_BUNDLE=./runtimes

# Comma-separated external tasks to enable in WORKER_MODE=local.
# Example: ENABLED_EXTERNAL_MODELS=total,lungmask_r231
ENABLED_EXTERNAL_MODELS=

# Catalog refresh and per-task execution limits (seconds).
CATALOG_TTL_SECONDS=600
PREFLIGHT_TIMEOUT_SECONDS=900
TASK_TIME_LIMIT_SECONDS=43200
TASK_STOP_GRACE_SECONDS=45
PORTAL_DATA=/data
ENABLED_MODELS_FILE=/data/enabled-models.txt
RTSEG_APP_ROOT=/app
RTSEG_MODEL_ROOT=/models
RTSEG_RUNTIME_ROOT=/runtimes
RTSEG_SCRATCH_ROOT=/scratch
RTSEG_ORIENTATION_VALIDATION=/models/orientation-validation
# Optional external fixture map for orientation audits; never commit private identifiers.
# RTSEG_ORIENTATION_FIXTURES=/data/config/orientation-fixtures.json
# RTSEG_ORIENTATION_PROMPTS=/data/config/orientation-prompts.json
