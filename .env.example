# Optional API protection. Generate a long random value for production.
RTSEG_API_KEY=
RETENTION_HOURS=24
MAX_UPLOAD_BYTES=8589934592

# local: WebUI and GPU inference in the offline image
# ssh: WebUI sends selected series to a remote worker
WORKER_MODE=local
SEGMENTATION_WORKER=konrad@worker.example.org
WORKER_SSH_PORT=22
REMOTE_JOB_ROOT=/var/lib/rtsegmentator/jobs
REMOTE_PYTHON=/home/konrad/dicom-rt-seg/.venv/bin/python
REMOTE_RUNNER=/home/konrad/dicom-rt-seg/run_task.py
LOCAL_PYTHON=/home/konrad/dicom-rt-seg/.venv/bin/python
LOCAL_RUNNER=/home/konrad/dicom-rt-seg/run_task.py
