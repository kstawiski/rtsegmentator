FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORTAL_DATA=/var/lib/rtsegmentator/jobs \
    WORKER_MODE=ssh

RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-client tar ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/rtsegmentator
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY *.py *.json *.yaml *.ini ./
COPY labels/ ./labels/
COPY docs/ ./docs/
COPY EXTERNAL_MODELS.md README.md ./
RUN mkdir -p /var/lib/rtsegmentator/jobs

EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
