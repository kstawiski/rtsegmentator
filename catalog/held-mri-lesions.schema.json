{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NCI and U-MambaMTL lesion result",
  "type": "object",
  "required": ["schema_version", "task", "status", "reference_role", "channel_order", "lesions", "extraction", "provenance", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"enum": ["nci_monai_prostate_lesion_bpmri", "umambamtl_cspca_bpmri"]},
    "status": {"enum": ["empty", "nonempty"]},
    "reference_role": {"const": "t2w"},
    "channel_order": {"const": ["t2w", "adc", "hbv"]},
    "lesions": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "roi_name", "voxel_count", "volume_ml"], "properties": {
      "candidate_id": {"type": "integer", "minimum": 1},
      "roi_name": {"type": "string", "maxLength": 64},
      "voxel_count": {"type": "integer", "minimum": 1},
      "volume_ml": {"type": "number", "exclusiveMinimum": 0}
    }}},
    "extraction": {"type": "object"}, "provenance": {"type": "object"}, "artifacts": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"task": {"const": "umambamtl_cspca_bpmri"}}}, "then": {
      "required": ["case_likelihood", "upstream_channel_keys"],
      "properties": {
        "case_likelihood": {"type": "number", "minimum": 0, "maximum": 1},
        "upstream_channel_keys": {"const": ["t2w", "hbv", "adc"]},
        "lesions": {"maxItems": 3, "items": {"required": ["likelihood"], "properties": {
          "candidate_id": {"maximum": 3}, "roi_name": {"pattern": "^UMMTL_L0[1-3]_p(0\\.[0-9]{2}|1\\.00)$"},
          "likelihood": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }}}
      }
    }, "else": {
      "required": ["gland"], "properties": {"lesions": {"items": {
        "required": ["pi_rads", "classifier_probabilities", "major_axis_length_mm", "classifier_volume_ml"],
        "properties": {
          "roi_name": {"pattern": "^NCI_L[0-9]{2,}_PIRADS[2-5]$"},
          "pi_rads": {"enum": [2, 3, 4, 5]},
          "classifier_probabilities": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "major_axis_length_mm": {"type": "number", "minimum": 0}, "classifier_volume_ml": {"type": "number", "exclusiveMinimum": 0}
        }
      }}}
    }},
    {"if": {"properties": {"status": {"const": "empty"}}}, "then": {"properties": {"lesions": {"maxItems": 0}}}, "else": {"properties": {"lesions": {"minItems": 1}}}}
  ]
}
